{
    "manifest_version": 2,
    "name": "Canvas Assignment Dashboard",
    "version": "1.0",
    "description": "View all Canvas assignments across courses",
    "permissions": ["storage"],
    "host_permissions": [
        "https://*.instructure.com/api/v1/*"
    ],
    "action": {
        "newtab": "dashboard.html",
        "default_title": "Canvas Dashboard"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    }

}